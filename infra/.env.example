# Valores só para desenvolvimento local. Copie para .env (não versionado).

# RabbitMQ — painel em http://localhost:15672
RABBITMQ_USER=facoffee
RABBITMQ_PASSWORD=facoffee

# PostgreSQL — uma instância, um banco por serviço (usuário e banco têm o nome do serviço)
POSTGRES_PASSWORD=postgres
USUARIO_DB_PASSWORD=usuario
PARTICIPACAO_DB_PASSWORD=participacao
FINANCEIRO_DB_PASSWORD=financeiro
NOTIFICACAO_DB_PASSWORD=notificacao
EXAMPLE_DB_PASSWORD=example

# Keycloak — console em http://localhost:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# SeaweedFS (S3) — endpoint http://localhost:8333
S3_ACCESS_KEY=facoffee
S3_SECRET_KEY=facoffee-secret
