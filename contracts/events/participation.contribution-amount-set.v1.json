{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/hsborges/facoffee-app/blob/main/contracts/events/participation.contribution-amount-set.v1.json",
  "title": "Valor da cota definido",
  "description": "O gestor definiu o valor de um tipo de cota para o ano.",
  "type": "object",
  "allOf": [{ "$ref": "envelope.v1.json" }],
  "properties": {
    "type": { "const": "participation.contribution-amount-set" },
    "version": { "const": 1 },
    "payload": {
      "type": "object",
      "required": ["contributionType", "year", "amountInCents"],
      "properties": {
        "contributionType": {
          "type": "string",
          "enum": ["coffee-only", "full"],
          "description": "Tipo de cota: só café ou completa."
        },
        "year": { "type": "integer", "minimum": 2000, "description": "Ano em que o valor vale." },
        "amountInCents": {
          "type": "integer",
          "minimum": 1,
          "description": "Valor mensal do tipo de cota em centavos de real."
        }
      }
    }
  },
  "examples": [
    {
      "id": "0b6f2f0e-6a1c-4c55-9a43-6f1f1b0c9e14",
      "type": "participation.contribution-amount-set",
      "version": 1,
      "occurredAt": "2026-11-01T03:00:00Z",
      "payload": { "contributionType": "coffee-only", "year": 2027, "amountInCents": 2500 }
    }
  ]
}
