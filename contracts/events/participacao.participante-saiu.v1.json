        "participanteId": {
          "type": "string",
          "format": "uuid",
          "description": "Identificador da pessoa, o mesmo do contexto Usuário (sub do Passaporte UFMS)."
        }
      }
    }
  },
  "examples": [
    {
      "id": "0b6f2f0e-6a1c-4c55-9a43-6f1f1b0c9e12",
      "tipo": "participacao.participante-saiu",
      "versao": 1,
      "ocorridoEm": "2026-11-01T03:00:00Z",
      "payload": { "participanteId": "7a6b5c4d-3e2f-4a1b-9c8d-7e6f5a4b3c2d" }
    }
  ]
}
