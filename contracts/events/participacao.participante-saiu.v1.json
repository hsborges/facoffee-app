{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/hsborges/facoffee-app/blob/main/contracts/events/participacao.participante-saiu.v1.json",
  "title": "Participante saiu",
  "description": "O participante pediu a saída ou teve o acesso desativado.",
  "type": "object",
  "allOf": [{ "$ref": "envelope.v1.json" }],
  "properties": {
    "tipo": { "const": "participacao.participante-saiu" },
