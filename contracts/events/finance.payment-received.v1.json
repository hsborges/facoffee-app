{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/hsborges/facoffee-app/blob/main/contracts/events/finance.payment-received.v1.json",
  "title": "Pagamento recebido",
  "description": "O gestor recebeu dinheiro para as cotas de um participante, por PIX com comprovante ou em mãos.",
  "type": "object",
  "allOf": [{ "$ref": "envelope.v1.json" }],
  "properties": {
    "type": { "const": "finance.payment-received" },
    "version": { "const": 1 },
    "payload": {
      "type": "object",
      "required": ["paymentId", "participantId", "amountInCents", "method"],
      "properties": {
        "paymentId": {
          "type": "string",
          "format": "uuid",
          "description": "Identificador do pagamento."
        },
        "participantId": {
          "type": "string",
          "format": "uuid",
          "description": "Participante cujas cotas o pagamento quita, mesmo que outra pessoa tenha pago; o mesmo identificador do contexto Usuário (sub do Passaporte UFMS)."
        },
        "amountInCents": {
          "type": "integer",
          "minimum": 1,
          "description": "Valor recebido em centavos de real."
        },
        "method": {
          "type": "string",
          "enum": ["pix", "cash"],
          "description": "Forma do pagamento."
        }
      }
    }
  },
  "examples": [
    {
      "id": "0b6f2f0e-6a1c-4c55-9a43-6f1f1b0c9e15",
      "type": "finance.payment-received",
      "version": 1,
      "occurredAt": "2026-11-01T03:00:00Z",
      "payload": {
        "paymentId": "9d8e7f60-5a4b-4c3d-8e2f-1a0b9c8d7e6f",
        "participantId": "7a6b5c4d-3e2f-4a1b-9c8d-7e6f5a4b3c2d",
        "amountInCents": 18000,
        "method": "pix"
      }
    }
  ]
}
