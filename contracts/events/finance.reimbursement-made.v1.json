{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/hsborges/facoffee-app/blob/main/contracts/events/finance.reimbursement-made.v1.json",
  "title": "Reembolso feito",
  "description": "O gestor devolveu o valor a quem pagou um gasto do próprio bolso.",
  "type": "object",
  "allOf": [{ "$ref": "envelope.v1.json" }],
  "properties": {
    "type": { "const": "finance.reimbursement-made" },
    "version": { "const": 1 },
    "payload": {
      "type": "object",
      "required": ["reimbursementId", "expenseId", "participantId", "amountInCents"],
      "properties": {
        "reimbursementId": {
          "type": "string",
          "format": "uuid",
          "description": "Identificador do reembolso."
        },
        "expenseId": {
          "type": "string",
          "format": "uuid",
          "description": "Identificador do gasto reembolsado."
        },
        "participantId": {
          "type": "string",
          "format": "uuid",
          "description": "Identificador da pessoa, o mesmo do contexto Usuário (sub do Passaporte UFMS)."
        },
        "amountInCents": {
          "type": "integer",
          "minimum": 1,
          "description": "Valor devolvido em centavos de real."
        }
      }
    }
  },
  "examples": [
    {
      "id": "0b6f2f0e-6a1c-4c55-9a43-6f1f1b0c9e17",
      "type": "finance.reimbursement-made",
      "version": 1,
      "occurredAt": "2026-11-01T03:00:00Z",
      "payload": {
        "reimbursementId": "e1d2c3b4-a596-4877-b869-5a4b3c2d1e0f",
        "expenseId": "3f1c2a9e-8b7d-4e6f-9a10-2b3c4d5e6f70",
        "participantId": "2b3c4d5e-6f70-4a81-9b2c-3d4e5f6a7b8c",
        "amountInCents": 4590
      }
    }
  ]
}
