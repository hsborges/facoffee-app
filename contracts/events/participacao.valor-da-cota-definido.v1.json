{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/hsborges/facoffee-app/blob/main/contracts/events/participacao.valor-da-cota-definido.v1.json",
  "title": "Valor da cota definido",
  "description": "O gestor definiu o valor de um tipo de cota para o ano.",
  "type": "object",
  "allOf": [{ "$ref": "envelope.v1.json" }],
  "properties": {
    "tipo": { "const": "participacao.valor-da-cota-definido" },
    "versao": { "const": 1 },
    "payload": {
      "type": "object",
      "required": ["tipoDeCota", "ano", "valorEmCentavos"],
      "properties": {
        "tipoDeCota": {
          "type": "string",
          "enum": ["so-cafe", "completa"],
          "description": "Tipo de cota: só café ou completa."
        },
        "ano": { "type": "integer", "minimum": 2000, "description": "Ano em que o valor vale." },
        "valorEmCentavos": {
          "type": "integer",
          "minimum": 1,
          "description": "Valor mensal do tipo de cota em centavos de real."
        }
      }
    }
  },
  "examples": [
    {
      "id": "0b6f2f0e-6a1c-4c55-9a43-6f1f1b0c9e14",
      "tipo": "participacao.valor-da-cota-definido",
      "versao": 1,
      "ocorridoEm": "2026-11-01T03:00:00Z",
      "payload": { "tipoDeCota": "so-cafe", "ano": 2027, "valorEmCentavos": 2500 }
    }
  ]
}
