  "components": {
    "messages": {
      "usuario.usuario-desativado.v1": {
        "name": "usuario.usuario-desativado",
        "title": "Usuário desativado",
        "summary": "O acesso de uma pessoa ao FACOFFEE foi desativado, pelo gestor ou a pedido da própria pessoa.",
        "contentType": "application/json",
        "payload": { "$ref": "./usuario.usuario-desativado.v1.json" }
      },
      "participacao.participante-entrou.v1": {
        "name": "participacao.participante-entrou",
        "title": "Participante entrou",
        "summary": "Uma pessoa passou a participar, pela primeira vez ou retornando, com um tipo de cota.",
        "contentType": "application/json",
        "payload": { "$ref": "./participacao.participante-entrou.v1.json" }
      },
      "participacao.participante-saiu.v1": {
        "name": "participacao.participante-saiu",
        "title": "Participante saiu",
        "summary": "O participante pediu a saída ou teve o acesso desativado.",
        "contentType": "application/json",
        "payload": { "$ref": "./participacao.participante-saiu.v1.json" }
      },
      "participacao.cota-devida.v1": {
        "name": "participacao.cota-devida",
        "title": "Cota devida",
        "summary": "O participante passou a dever a cota do mês, com o valor do seu tipo de cota.",
        "contentType": "application/json",
        "payload": { "$ref": "./participacao.cota-devida.v1.json" }
      },
      "participacao.valor-da-cota-definido.v1": {
        "name": "participacao.valor-da-cota-definido",
        "title": "Valor da cota definido",
        "summary": "O gestor definiu o valor de um tipo de cota para o ano.",
        "contentType": "application/json",
        "payload": { "$ref": "./participacao.valor-da-cota-definido.v1.json" }
      },
      "financeiro.pagamento-recebido.v1": {
        "name": "financeiro.pagamento-recebido",
        "title": "Pagamento recebido",
        "summary": "O gestor recebeu dinheiro de um participante, por PIX com comprovante ou em mãos.",
        "contentType": "application/json",
        "payload": { "$ref": "./financeiro.pagamento-recebido.v1.json" }
      },
      "financeiro.complemento-solicitado.v1": {
        "name": "financeiro.complemento-solicitado",
        "title": "Complemento solicitado",
        "summary": "O gestor pediu um complemento; cada participante ativo passou a dever uma parte igual.",
        "contentType": "application/json",
        "payload": { "$ref": "./financeiro.complemento-solicitado.v1.json" }
      },
      "financeiro.reembolso-feito.v1": {
        "name": "financeiro.reembolso-feito",
        "title": "Reembolso feito",
        "summary": "O gestor devolveu o valor a quem pagou um gasto do próprio bolso.",
        "contentType": "application/json",
        "payload": { "$ref": "./financeiro.reembolso-feito.v1.json" }
      }
    }
  }
}
