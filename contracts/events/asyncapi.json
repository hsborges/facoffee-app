  "operations": {
    "publicar.usuario.usuario-desativado.v1": {
      "action": "send",
      "title": "Usuário publica Usuário desativado",
      "tags": [{ "name": "Usuário" }],
      "channel": { "$ref": "#/channels/usuario.usuario-desativado.v1" },
      "messages": [
        {
          "$ref": "#/channels/usuario.usuario-desativado.v1/messages/usuario.usuario-desativado.v1"
        }
      ]
    },
    "publicar.participacao.participante-entrou.v1": {
