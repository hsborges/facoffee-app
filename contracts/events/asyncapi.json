{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Eventos de domínio do FACOFFEE",
    "version": "1.0.0",
    "description": "Eventos trocados entre os contextos via RabbitMQ. Convenções e versionamento em README.md e no ADR 0006."
  },
  "defaultContentType": "application/json",
  "servers": {
    "local": {
      "host": "localhost:5672",
      "protocol": "amqp",
      "description": "RabbitMQ do ambiente local (infra/docker-compose.yml)."
    }
  },
  "channels": {
    "user.user-deactivated.v1": {
      "address": "user.user-deactivated.v1",
      "title": "Usuário desativado",
      "messages": {
        "user.user-deactivated.v1": {
          "$ref": "#/components/messages/user.user-deactivated.v1"
        }
      },
      "bindings": {
        "amqp": {
          "is": "routingKey",
          "exchange": {
            "name": "facoffee.events",
            "type": "topic",
            "durable": true,
            "autoDelete": false,
            "vhost": "/"
          },
          "bindingVersion": "0.3.0"
        }
      }
    },
    "participation.participant-joined.v1": {
      "address": "participation.participant-joined.v1",
      "title": "Participante entrou",
      "messages": {
        "participation.participant-joined.v1": {
          "$ref": "#/components/messages/participation.participant-joined.v1"
        }
      },
      "bindings": {
        "amqp": {
          "is": "routingKey",
          "exchange": {
            "name": "facoffee.events",
            "type": "topic",
            "durable": true,
            "autoDelete": false,
            "vhost": "/"
          },
          "bindingVersion": "0.3.0"
        }
      }
    },
    "participation.participant-left.v1": {
      "address": "participation.participant-left.v1",
      "title": "Participante saiu",
      "messages": {
        "participation.participant-left.v1": {
          "$ref": "#/components/messages/participation.participant-left.v1"
        }
      },
      "bindings": {
        "amqp": {
          "is": "routingKey",
          "exchange": {
            "name": "facoffee.events",
            "type": "topic",
            "durable": true,
            "autoDelete": false,
            "vhost": "/"
          },
          "bindingVersion": "0.3.0"
        }
      }
    },
    "participation.contribution-due.v1": {
      "address": "participation.contribution-due.v1",
      "title": "Cota devida",
      "messages": {
        "participation.contribution-due.v1": {
          "$ref": "#/components/messages/participation.contribution-due.v1"
        }
      },
      "bindings": {
        "amqp": {
          "is": "routingKey",
          "exchange": {
            "name": "facoffee.events",
            "type": "topic",
            "durable": true,
            "autoDelete": false,
            "vhost": "/"
          },
          "bindingVersion": "0.3.0"
        }
      }
    },
    "participation.contribution-amount-set.v1": {
      "address": "participation.contribution-amount-set.v1",
      "title": "Valor da cota definido",
      "messages": {
        "participation.contribution-amount-set.v1": {
          "$ref": "#/components/messages/participation.contribution-amount-set.v1"
        }
      },
      "bindings": {
        "amqp": {
          "is": "routingKey",
          "exchange": {
            "name": "facoffee.events",
            "type": "topic",
            "durable": true,
            "autoDelete": false,
            "vhost": "/"
          },
          "bindingVersion": "0.3.0"
        }
      }
    },
    "finance.payment-received.v1": {
      "address": "finance.payment-received.v1",
      "title": "Pagamento recebido",
      "messages": {
        "finance.payment-received.v1": {
          "$ref": "#/components/messages/finance.payment-received.v1"
        }
      },
      "bindings": {
        "amqp": {
          "is": "routingKey",
          "exchange": {
            "name": "facoffee.events",
            "type": "topic",
            "durable": true,
            "autoDelete": false,
            "vhost": "/"
          },
          "bindingVersion": "0.3.0"
        }
      }
    },
    "finance.top-up-requested.v1": {
      "address": "finance.top-up-requested.v1",
      "title": "Complemento solicitado",
      "messages": {
        "finance.top-up-requested.v1": {
          "$ref": "#/components/messages/finance.top-up-requested.v1"
        }
      },
      "bindings": {
        "amqp": {
          "is": "routingKey",
          "exchange": {
            "name": "facoffee.events",
            "type": "topic",
            "durable": true,
            "autoDelete": false,
            "vhost": "/"
          },
          "bindingVersion": "0.3.0"
        }
      }
    },
    "finance.reimbursement-made.v1": {
      "address": "finance.reimbursement-made.v1",
      "title": "Reembolso feito",
      "messages": {
        "finance.reimbursement-made.v1": {
          "$ref": "#/components/messages/finance.reimbursement-made.v1"
        }
      },
      "bindings": {
        "amqp": {
          "is": "routingKey",
          "exchange": {
            "name": "facoffee.events",
            "type": "topic",
            "durable": true,
            "autoDelete": false,
            "vhost": "/"
          },
          "bindingVersion": "0.3.0"
        }
      }
    },
    "participation.events": {
      "address": "participation.events",
      "description": "Fila de Participação, ligada ao exchange facoffee.events pelas routing keys: user.user-deactivated.v1.",
      "messages": {
        "user.user-deactivated.v1": {
          "$ref": "#/components/messages/user.user-deactivated.v1"
        }
      },
      "bindings": {
        "amqp": {
          "is": "queue",
          "queue": {
            "name": "participation.events",
            "durable": true,
            "exclusive": false,
            "autoDelete": false,
            "vhost": "/"
          },
          "bindingVersion": "0.3.0"
        }
      }
    },
    "finance.events": {
      "address": "finance.events",
      "description": "Fila de Financeiro, ligada ao exchange facoffee.events pelas routing keys: participation.participant-joined.v1, participation.participant-left.v1, participation.contribution-due.v1.",
      "messages": {
        "participation.participant-joined.v1": {
          "$ref": "#/components/messages/participation.participant-joined.v1"
        },
        "participation.participant-left.v1": {
          "$ref": "#/components/messages/participation.participant-left.v1"
        },
        "participation.contribution-due.v1": {
          "$ref": "#/components/messages/participation.contribution-due.v1"
        }
      },
      "bindings": {
        "amqp": {
          "is": "queue",
          "queue": {
            "name": "finance.events",
            "durable": true,
            "exclusive": false,
            "autoDelete": false,
            "vhost": "/"
          },
          "bindingVersion": "0.3.0"
        }
      }
    },
    "notification.events": {
      "address": "notification.events",
      "description": "Fila de Notificação, ligada ao exchange facoffee.events pelas routing keys: participation.contribution-amount-set.v1, finance.payment-received.v1, finance.top-up-requested.v1, finance.reimbursement-made.v1.",
      "messages": {
        "participation.contribution-amount-set.v1": {
          "$ref": "#/components/messages/participation.contribution-amount-set.v1"
        },
        "finance.payment-received.v1": {
          "$ref": "#/components/messages/finance.payment-received.v1"
        },
        "finance.top-up-requested.v1": {
          "$ref": "#/components/messages/finance.top-up-requested.v1"
        },
        "finance.reimbursement-made.v1": {
          "$ref": "#/components/messages/finance.reimbursement-made.v1"
        }
      },
      "bindings": {
        "amqp": {
          "is": "queue",
          "queue": {
            "name": "notification.events",
            "durable": true,
            "exclusive": false,
            "autoDelete": false,
            "vhost": "/"
          },
          "bindingVersion": "0.3.0"
        }
      }
    }
  },
  "operations": {
    "publish.user.user-deactivated.v1": {
      "action": "send",
      "title": "Usuário publica Usuário desativado",
      "tags": [{ "name": "Usuário" }],
      "channel": { "$ref": "#/channels/user.user-deactivated.v1" },
      "messages": [
        {
          "$ref": "#/channels/user.user-deactivated.v1/messages/user.user-deactivated.v1"
        }
      ]
    },
    "publish.participation.participant-joined.v1": {
      "action": "send",
      "title": "Participação publica Participante entrou",
      "tags": [{ "name": "Participação" }],
      "channel": { "$ref": "#/channels/participation.participant-joined.v1" },
      "messages": [
        {
          "$ref": "#/channels/participation.participant-joined.v1/messages/participation.participant-joined.v1"
        }
      ]
    },
    "publish.participation.participant-left.v1": {
      "action": "send",
      "title": "Participação publica Participante saiu",
      "tags": [{ "name": "Participação" }],
      "channel": { "$ref": "#/channels/participation.participant-left.v1" },
      "messages": [
        {
          "$ref": "#/channels/participation.participant-left.v1/messages/participation.participant-left.v1"
        }
      ]
    },
    "publish.participation.contribution-due.v1": {
      "action": "send",
      "title": "Participação publica Cota devida",
      "tags": [{ "name": "Participação" }],
      "channel": { "$ref": "#/channels/participation.contribution-due.v1" },
      "messages": [
        {
          "$ref": "#/channels/participation.contribution-due.v1/messages/participation.contribution-due.v1"
        }
      ]
    },
    "publish.participation.contribution-amount-set.v1": {
      "action": "send",
      "title": "Participação publica Valor da cota definido",
      "tags": [{ "name": "Participação" }],
      "channel": { "$ref": "#/channels/participation.contribution-amount-set.v1" },
      "messages": [
        {
          "$ref": "#/channels/participation.contribution-amount-set.v1/messages/participation.contribution-amount-set.v1"
        }
      ]
    },
    "publish.finance.payment-received.v1": {
      "action": "send",
      "title": "Financeiro publica Pagamento recebido",
      "tags": [{ "name": "Financeiro" }],
      "channel": { "$ref": "#/channels/finance.payment-received.v1" },
      "messages": [
        {
          "$ref": "#/channels/finance.payment-received.v1/messages/finance.payment-received.v1"
        }
      ]
    },
    "publish.finance.top-up-requested.v1": {
      "action": "send",
      "title": "Financeiro publica Complemento solicitado",
      "tags": [{ "name": "Financeiro" }],
      "channel": { "$ref": "#/channels/finance.top-up-requested.v1" },
      "messages": [
        {
          "$ref": "#/channels/finance.top-up-requested.v1/messages/finance.top-up-requested.v1"
        }
      ]
    },
    "publish.finance.reimbursement-made.v1": {
      "action": "send",
      "title": "Financeiro publica Reembolso feito",
      "tags": [{ "name": "Financeiro" }],
      "channel": { "$ref": "#/channels/finance.reimbursement-made.v1" },
      "messages": [
        {
          "$ref": "#/channels/finance.reimbursement-made.v1/messages/finance.reimbursement-made.v1"
        }
      ]
    },
    "consume.participation": {
      "action": "receive",
      "title": "Participação consome",
      "tags": [{ "name": "Participação" }],
      "channel": { "$ref": "#/channels/participation.events" },
      "messages": [{ "$ref": "#/channels/participation.events/messages/user.user-deactivated.v1" }]
    },
    "consume.finance": {
      "action": "receive",
      "title": "Financeiro consome",
      "tags": [{ "name": "Financeiro" }],
      "channel": { "$ref": "#/channels/finance.events" },
      "messages": [
        { "$ref": "#/channels/finance.events/messages/participation.participant-joined.v1" },
        { "$ref": "#/channels/finance.events/messages/participation.participant-left.v1" },
        { "$ref": "#/channels/finance.events/messages/participation.contribution-due.v1" }
      ]
    },
    "consume.notification": {
      "action": "receive",
      "title": "Notificação consome",
      "tags": [{ "name": "Notificação" }],
      "channel": { "$ref": "#/channels/notification.events" },
      "messages": [
        {
          "$ref": "#/channels/notification.events/messages/participation.contribution-amount-set.v1"
        },
        { "$ref": "#/channels/notification.events/messages/finance.payment-received.v1" },
        { "$ref": "#/channels/notification.events/messages/finance.top-up-requested.v1" },
        { "$ref": "#/channels/notification.events/messages/finance.reimbursement-made.v1" }
      ]
    }
  },
  "components": {
    "messages": {
      "user.user-deactivated.v1": {
        "name": "user.user-deactivated",
        "title": "Usuário desativado",
        "summary": "O acesso de uma pessoa ao FACOFFEE foi desativado, pelo gestor ou a pedido da própria pessoa.",
        "contentType": "application/json",
        "payload": { "$ref": "./user.user-deactivated.v1.json" }
      },
      "participation.participant-joined.v1": {
        "name": "participation.participant-joined",
        "title": "Participante entrou",
        "summary": "Uma pessoa passou a participar, pela primeira vez ou retornando, com um tipo de cota.",
        "contentType": "application/json",
        "payload": { "$ref": "./participation.participant-joined.v1.json" }
      },
      "participation.participant-left.v1": {
        "name": "participation.participant-left",
        "title": "Participante saiu",
        "summary": "O participante pediu a saída ou teve o acesso desativado.",
        "contentType": "application/json",
        "payload": { "$ref": "./participation.participant-left.v1.json" }
      },
      "participation.contribution-due.v1": {
        "name": "participation.contribution-due",
        "title": "Cota devida",
        "summary": "O participante passou a dever a cota do mês, com o valor do seu tipo de cota.",
        "contentType": "application/json",
        "payload": { "$ref": "./participation.contribution-due.v1.json" }
      },
      "participation.contribution-amount-set.v1": {
        "name": "participation.contribution-amount-set",
        "title": "Valor da cota definido",
        "summary": "O gestor definiu o valor de um tipo de cota para o ano.",
        "contentType": "application/json",
        "payload": { "$ref": "./participation.contribution-amount-set.v1.json" }
      },
      "finance.payment-received.v1": {
        "name": "finance.payment-received",
        "title": "Pagamento recebido",
        "summary": "O gestor recebeu dinheiro de um participante, por PIX com comprovante ou em mãos.",
        "contentType": "application/json",
        "payload": { "$ref": "./finance.payment-received.v1.json" }
      },
      "finance.top-up-requested.v1": {
        "name": "finance.top-up-requested",
        "title": "Complemento solicitado",
        "summary": "O gestor pediu um complemento; cada participante ativo passou a dever uma parte igual.",
        "contentType": "application/json",
        "payload": { "$ref": "./finance.top-up-requested.v1.json" }
      },
      "finance.reimbursement-made.v1": {
        "name": "finance.reimbursement-made",
        "title": "Reembolso feito",
        "summary": "O gestor devolveu o valor a quem pagou um gasto do próprio bolso.",
        "contentType": "application/json",
        "payload": { "$ref": "./finance.reimbursement-made.v1.json" }
      }
    }
  }
}
