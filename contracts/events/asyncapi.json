      "address": "participacao.eventos",
      "description": "Fila de Participação, ligada ao exchange facoffee.eventos pelas routing keys: usuario.usuario-desativado.v1.",
      "messages": {
        "usuario.usuario-desativado.v1": {
          "$ref": "#/components/messages/usuario.usuario-desativado.v1"
