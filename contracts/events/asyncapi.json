{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Eventos de domínio do FACOFFEE",
    "version": "1.0.0",
    "description": "Eventos trocados entre os contextos via RabbitMQ. Convenções e versionamento em README.md e no ADR 0004."
  },
  "defaultContentType": "application/json",
  "servers": {
    "local": {
      "host": "localhost:5672",
      "protocol": "amqp",
      "description": "RabbitMQ do ambiente local (infra/docker-compose.yml)."
    }
